{
  "version": 6,
  "configurePresets": [
    {
      "name": "macos-clang",
      "displayName": "macOS Clang Ninja Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux GCC Ninja Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux Clang Ninja Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC Visual Studio 17 2022",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-clang",
      "displayName": "macOS Clang Ninja Release",
      "configurePreset": "macos-clang",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux GCC Ninja Release",
      "configurePreset": "linux-gcc",
      "configuration": "Release"
    },
    {
      "name": "linux-clang",
      "displayName": "Linux Clang Ninja Release",
      "configurePreset": "linux-clang",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC Visual Studio 17 2022",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "macos-clang",
      "displayName": "macOS Clang Ninja Release",
      "configurePreset": "macos-clang",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux GCC Ninja Release",
      "configurePreset": "linux-gcc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux Clang Ninja Release",
      "configurePreset": "linux-clang",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC Visual Studio 17 2022",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

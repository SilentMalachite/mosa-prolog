# ADR 0023。mosac dist が書いた書庫を cmake -E tar で展開し、中の実行ファイルを動かし、LICENSE、NOTICE、README.txt を
# 確かめる。展開を CMake に任せるのは、mosac が書いた形を mosac と別の実装（libarchive）で読むため。
# 使い方: cmake -DMOSAC=<mosac> -DCASE=<hello|default_dir|japanese|replace|out_is_file|tmp_link|name_clash|build_fails>
#   -DSRC=<tests/mosac> -DWORK=<一時ディレクトリ> -DCXX=<コンパイラ。空なら mosac の既定> -DEXE_SUFFIX=<.exe など>
#   -DMOSA_LIB=<lib/> -DROOT=<リポジトリの根> -DOS_ARCH=<macos-arm64 など> -DARCHIVE_EXT=<.tar.gz か .zip>
#   -P dist_test.cmake

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(ENV{MOSA_WERROR} 1)
set(compiler_env)
if(CXX)
  set(compiler_env "MOSA_CXX=${CXX}")
endif()

# mosac を WORK で動かす。結果は code、out、err に入る。
macro(mosac)
  # ENCODING UTF-8: 子は UTF-8 で書く。Windows の既定は CMP0176（3.31）が NEW でなければ AUTO で、コンソールのコードページで読み、932 などでは化ける。
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${compiler_env} "MOSA_LIB=${MOSA_LIB}" "${MOSAC}" ${ARGN}
    WORKING_DIRECTORY "${WORK}"
    OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE code TIMEOUT 600 ENCODING UTF-8)
  string(REPLACE "\r\n" "\n" out "${out}")
  string(REPLACE "\r\n" "\n" err "${err}")
endmacro()

function(fail what)
  message(FATAL_ERROR "${CASE}: ${what}: code=[${code}] out=[${out}] err=[${err}]")
endfunction()

# 標準出力の最後の行が書庫のパスで、want で終わり、そのファイルがあること。
function(expect_archive want)
  string(REGEX REPLACE "\n$" "" last "${out}")
  string(REGEX REPLACE "^.*\n" "" last "${last}")
  string(REPLACE "\\" "/" last "${last}")
  string(LENGTH "${last}" last_len)
  string(LENGTH "${want}" want_len)
  if(last_len LESS want_len)
    fail("the last line of stdout must be the archive path ending in ${want}")
  endif()
  math(EXPR tail_at "${last_len} - ${want_len}")
  string(SUBSTRING "${last}" ${tail_at} -1 tail)
  if(NOT code EQUAL 0 OR NOT tail STREQUAL want OR NOT EXISTS "${WORK}/${want}")
    fail("the archive ${want}")
  endif()
endfunction()

# 書庫を WORK/x に展開し、<stem>-<OS_ARCH>/ の実行ファイルを動かして、3 つの文書を確かめる。
function(expect_unpacked archive stem)
  file(REMOVE_RECURSE "${WORK}/x")
  file(MAKE_DIRECTORY "${WORK}/x")
  # 展開は UTF-8 のロケールで行う。テストは一括で LANG=ja_JP.UTF-8 にするが、Ubuntu の CI にはそのロケールが無く C に
  # 落ち、cmake -E tar（libarchive）は PAX の UTF-8 の名前を C のロケールへ変えられずに別の名前で書く。
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env LC_ALL=C.UTF-8 "${CMAKE_COMMAND}" -E tar xf "${WORK}/${archive}"
    WORKING_DIRECTORY "${WORK}/x" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err ENCODING UTF-8)
  if(NOT code EQUAL 0)
    fail("unpack ${archive}")
  endif()
  set(folder "${WORK}/x/${stem}-${OS_ARCH}")
  execute_process(COMMAND "${folder}/${stem}${EXE_SUFFIX}" OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE code
    TIMEOUT 60 ENCODING UTF-8)
  string(REPLACE "\r\n" "\n" out "${out}")
  if(NOT code EQUAL 0 OR NOT out STREQUAL "こんにちは\n")
    file(GLOB_RECURSE unpacked RELATIVE "${WORK}/x" "${WORK}/x/*")
    fail("run the unpacked ${stem}${EXE_SUFFIX} (unpacked: [${unpacked}])")
  endif()
  foreach(doc LICENSE NOTICE)
    file(READ "${folder}/${doc}" got HEX)
    file(READ "${ROOT}/${doc}" want HEX)
    if(NOT got STREQUAL want)
      fail("${doc} must equal the repository's ${doc}")
    endif()
  endforeach()
  file(READ "${folder}/README.txt" readme)
  foreach(part "Mosa Prolog 0.1.1" "Apache License, Version 2.0" "このプログラムは Mosa Prolog 0.1.1 で作りました")
    string(FIND "${readme}" "${part}" at)
    if(at LESS 0)
      fail("README.txt must contain [${part}]: [${readme}]")
    endif()
  endforeach()
endfunction()

if(CASE STREQUAL "hello")
  # SPEC 第 6 節の書き方どおり、-o の後ろに / を付ける。
  mosac(dist "${SRC}/hello.pl" -o out/)
  expect_archive("out/hello-${OS_ARCH}${ARCHIVE_EXT}")
  expect_unpacked("out/hello-${OS_ARCH}${ARCHIVE_EXT}" hello)
elseif(CASE STREQUAL "default_dir")
  mosac(dist "${SRC}/hello.pl")
  expect_archive("dist/hello-${OS_ARCH}${ARCHIVE_EXT}")
elseif(CASE STREQUAL "japanese")
  file(COPY_FILE "${SRC}/hello.pl" "${WORK}/こんにちは.pl")
  mosac(dist こんにちは.pl -o out)
  expect_archive("out/こんにちは-${OS_ARCH}${ARCHIVE_EXT}")
  expect_unpacked("out/こんにちは-${OS_ARCH}${ARCHIVE_EXT}" こんにちは)
elseif(CASE STREQUAL "replace")
  mosac(dist "${SRC}/hello.pl" -o out)
  expect_archive("out/hello-${OS_ARCH}${ARCHIVE_EXT}")
  mosac(dist "${SRC}/hello.pl" -o out)
  expect_archive("out/hello-${OS_ARCH}${ARCHIVE_EXT}")
  expect_unpacked("out/hello-${OS_ARCH}${ARCHIVE_EXT}" hello)
  file(GLOB left "${WORK}/out/*")
  list(LENGTH left count)
  if(NOT count EQUAL 1)
    fail("out/ must hold the archive only: [${left}]")
  endif()
elseif(CASE STREQUAL "out_is_file")
  file(WRITE "${WORK}/out" "keep\n")
  mosac(dist "${SRC}/hello.pl" -o out)
  file(READ "${WORK}/out" kept)
  if(NOT code EQUAL 1 OR NOT err MATCHES "mosac: (書き出せません|cannot write): " OR NOT kept STREQUAL "keep\n")
    fail("an -o that is a file must stop with the cannot-write message and stay as it was")
  endif()
elseif(CASE STREQUAL "tmp_link")
  # 隣の一時ファイルの名前に別のファイルへのリンクが残っていても、リンクの先を書き換えない。
  file(WRITE "${WORK}/victim" "keep\n")
  file(MAKE_DIRECTORY "${WORK}/out")
  file(CREATE_LINK "${WORK}/victim" "${WORK}/out/hello-${OS_ARCH}${ARCHIVE_EXT}.tmp" SYMBOLIC COPY_ON_ERROR)
  mosac(dist "${SRC}/hello.pl" -o out)
  expect_archive("out/hello-${OS_ARCH}${ARCHIVE_EXT}")
  file(READ "${WORK}/victim" kept)
  if(NOT kept STREQUAL "keep\n" OR IS_SYMLINK "${WORK}/out/hello-${OS_ARCH}${ARCHIVE_EXT}")
    fail("a link at the temporary name must not be followed: victim=[${kept}]")
  endif()
  expect_unpacked("out/hello-${OS_ARCH}${ARCHIVE_EXT}" hello)
elseif(CASE STREQUAL "name_clash")
  # 実行ファイルが LICENSE と同じ名前になる（大文字小文字だけ違う）なら、作る前に止める。Windows は .exe が付くので重ならない。
  file(COPY_FILE "${SRC}/hello.pl" "${WORK}/license.pl")
  mosac(dist license.pl -o out)
  if(EXE_SUFFIX)
    expect_archive("out/license-${OS_ARCH}${ARCHIVE_EXT}")
    expect_unpacked("out/license-${OS_ARCH}${ARCHIVE_EXT}" license)
  elseif(NOT code EQUAL 1 OR NOT err MATCHES "mosac: (実行ファイル license は|the executable license would)"
         OR EXISTS "${WORK}/out")
    fail("an executable named like LICENSE must stop before building and write no out/")
  endif()
elseif(CASE STREQUAL "build_fails")
  mosac(build "${SRC}/broken.pl" -o broken)
  set(build_code "${code}")
  mosac(dist "${SRC}/broken.pl" -o out)
  if(code EQUAL 0 OR NOT code EQUAL build_code OR EXISTS "${WORK}/out")
    fail("a failed build must give the build's code (${build_code}) and write no out/")
  endif()
else()
  message(FATAL_ERROR "unknown CASE ${CASE}")
endif()

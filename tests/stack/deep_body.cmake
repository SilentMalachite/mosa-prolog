# レビュー 2026-11-20 の H-30、ADR 0011 の改訂 5。節の本体の長い連言と深い入れ子を、mosac emit が 1 MiB のスタックで
# 落ちずに訳す。前は 800 ゴールの連言と 800 段の ->、;、*->、\+、catch/3 で SIGSEGV になり、入れ子の if-then-else と \+ には
# 3 乗の時間がかかった（1,000 段で 17 秒と 120 秒超）。
# 前半: 17 の形を 100,000 段（連言は 100,000 ゴール）で 1 MiB の下で emit する。
# 後半: 64 段の上限の両側の形を 1 つのプログラムにまとめ、既定のスタックでビルドして、実行ファイルを 1 MiB で動かし、
# 出力を mosa と比べる。今の関数の中に出す入れ子（条件、\+ と catch/3 のゴール、M:G のゴール）が 64 段を超える節は IR に
# 回り、then と else と回復の入れ子や長い連言は訳したまま残ることを、生成コードで見る。
# 大きな原文は tests に置かず、ここで WORK に作る。
# 使い方: cmake -DMOSA=<mosa> -DMOSAC=<mosac> -DWORK=<一時ディレクトリ> -DCXX=<コンパイラ。空なら mosac の既定>
#   -DMOSA_LIB=<lib/> -DEXE_SUFFIX=<.exe など> -DSMALL_STACK=<small_stack.cmake> -P deep_body.cmake

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(ENV{MOSA_WERROR} 1)
set(ENV{MOSA_LIB} "${MOSA_LIB}")
set(compiler_env)
if(CXX)
  set(compiler_env "MOSA_CXX=${CXX}")
endif()

function(fail what)
  message(FATAL_ERROR "deep_body: ${what}: code=[${code}] out=[${out}] err=[${err}]")
endfunction()

# shape の本体を n 段（連言は n ゴール）で var に置く。どの形も g を呼び、成功する。
function(deep_goal shape n var)
  math(EXPR less "${n} - 1")
  if(shape STREQUAL "conj")
    string(REPEAT "g, " ${less} text)
    string(APPEND text "g")
  elseif(shape STREQUAL "lconj")
    string(REPEAT "(" ${less} open)
    string(REPEAT ", g)" ${less} close)
    set(text "${open}g${close}")
  elseif(shape STREQUAL "ite")
    string(REPEAT "(g -> " ${n} open)
    string(REPEAT " ; true)" ${n} close)
    set(text "${open}true${close}")
  elseif(shape STREQUAL "itee")
    string(REPEAT "(g -> true ; " ${n} open)
    string(REPEAT ")" ${n} close)
    set(text "${open}true${close}")
  elseif(shape STREQUAL "itec")
    string(REPEAT "(" ${n} open)
    string(REPEAT " -> true ; true)" ${n} close)
    set(text "${open}g${close}")
  elseif(shape STREQUAL "or")
    string(REPEAT "(fail ; " ${n} open)
    string(REPEAT ")" ${n} close)
    set(text "${open}g${close}")
  elseif(shape STREQUAL "orl")
    string(REPEAT "(" ${n} open)
    string(REPEAT " ; fail)" ${n} close)
    set(text "${open}g${close}")
  elseif(shape STREQUAL "not")
    # n は偶数にする（\+ が偶数個なら g と同じく成功する）。
    string(REPEAT "\\+ " ${n} open)
    set(text "${open}g")
  elseif(shape STREQUAL "catch")
    string(REPEAT "catch(" ${n} open)
    string(REPEAT ", _, true)" ${n} close)
    set(text "${open}g${close}")
  elseif(shape STREQUAL "recover")
    string(REPEAT "catch(throw(x), _, " ${n} open)
    string(REPEAT ")" ${n} close)
    set(text "${open}g${close}")
  elseif(shape STREQUAL "soft")
    string(REPEAT "(g *-> " ${n} open)
    string(REPEAT " ; true)" ${n} close)
    set(text "${open}true${close}")
  elseif(shape STREQUAL "qual")
    string(REPEAT "user:(" ${n} open)
    string(REPEAT ")" ${n} close)
    set(text "${open}g${close}")
  elseif(shape STREQUAL "call")
    string(REPEAT "call((" ${n} open)
    string(REPEAT "))" ${n} close)
    set(text "${open}g${close}")
  elseif(shape STREQUAL "notconj" OR shape STREQUAL "qualconj" OR shape STREQUAL "callconj")
    string(REPEAT "g, " ${less} inner)
    if(shape STREQUAL "notconj")
      set(text "\\+ \\+ (${inner}g)")
    elseif(shape STREQUAL "qualconj")
      set(text "user:(${inner}g)")
    else()
      set(text "call((${inner}g))")
    endif()
  elseif(shape STREQUAL "arith")
    # 呼び出しの後に n 個の算術。継続枠は呼び出しの後の 1 つだけで、n 個の変数を運ぶ（覚えは n の 2 乗にならない）。
    set(text "g")
    foreach(index RANGE 1 ${n})
      string(APPEND text ", X${index} is ${index}")
    endforeach()
    string(APPEND text ", w(X1, X${n})")
  elseif(shape STREQUAL "notite")
    deep_goal(ite ${n} inner)
    set(text "\\+ \\+ ${inner}")
  else()
    message(FATAL_ERROR "deep_body: unknown shape ${shape}")
  endif()
  set(${var} "${text}" PARENT_SCOPE)
endfunction()

# 前半。stdout は空で、終了コードは 0（small_stack.cmake が両方を見る）。
file(WRITE "${WORK}/empty.expected" "")
set(EXPECTED "${WORK}/empty.expected")
foreach(shape conj lconj ite itee itec or orl not catch recover soft qual call notconj qualconj callconj notite)
  deep_goal(${shape} 100000 goal)
  file(WRITE "${WORK}/deep_${shape}.pl" ":- initialization(main, main).\ng.\nmain :- ${goal}, write(done), nl.\n")
  set(COMMAND "${MOSAC}" emit "deep_${shape}.pl" -o "out_${shape}")
  include("${SMALL_STACK}")
endforeach()

# 後半。名前の数は段の数。inline64 と not64 は上限ちょうどで訳し、inline65、not66、qual65 は上限を超えて IR に回る。
# arith は 1,500 個の変数を 1 つの継続枠で運ぶだけなので訳す（接尾ごとに数えると 2^20 を超えてしまう形）。
set(program ":- initialization(main, main).\ng.\nw(_, _).\n")
set(names)
foreach(item "conj;1000;long" "ite;300;then" "itee;300;else" "recover;300;recover" "soft;300;soft"
    "itec;64;inline64" "itec;65;inline65" "not;64;not64" "not;66;not66" "qual;65;qual65" "orl;64;left64"
    "arith;1500;arith")
  list(GET item 0 shape)
  list(GET item 1 n)
  list(GET item 2 name)
  deep_goal(${shape} ${n} goal)
  string(APPEND program "${name} :- ${goal}.\n")
  list(APPEND names ${name})
endforeach()
list(JOIN names ", write(x), " calls)
string(APPEND program "main :- ${calls}, write(x), nl.\n")
file(WRITE "${WORK}/deep_body.pl" "${program}")

execute_process(COMMAND "${MOSA}" deep_body.pl WORKING_DIRECTORY "${WORK}"
  OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE code TIMEOUT 300 ENCODING UTF-8)
string(REPLACE "\r\n" "\n" out "${out}")
list(LENGTH names count)
string(REPEAT "x" ${count} marks)
if(NOT code EQUAL 0 OR NOT out STREQUAL "${marks}\n")
  fail("mosa")
endif()
file(WRITE "${WORK}/deep_body.expected" "${out}")

# 64 段の上限ちょうどの入れ子も、1 MiB のスタックで出せる。
set(COMMAND "${MOSAC}" emit deep_body.pl -o out_body)
set(EXPECTED "${WORK}/empty.expected")
include("${SMALL_STACK}")
file(READ "${WORK}/out_body/u0.cpp" unit)
# 訳した節は節の関数を持つ。測って IR に回した述語には印の注釈が付く。
foreach(name long then else recover soft inline64 not64 left64 arith)
  string(FIND "${unit}" "void p${name}_0_c1(Machine::Impl& m" at)
  if(at EQUAL -1)
    set(code "-")
    set(out "${name}")
    fail("a clause within the bounds must stay translated")
  endif()
endforeach()
foreach(name inline65 not66 qual65)
  string(FIND "${unit}" "// ${name}/0 はどの節も IR のまま動かす。" at)
  if(at EQUAL -1)
    set(code "-")
    set(out "${name}")
    fail("a clause nested past the 64-level bound must run as IR")
  endif()
endforeach()
# 回復のゴールの入れ子の段ごとに catch の _ が増える本体は、継続枠の変数が合わせて 2^20 を超える（2,000 段で約 200 万）。
# 出してから捨てるので節の関数を持たない。動かさずに emit だけを見る（インタプリタは回復のゴールが投げ直す入れ子を
# 1 MiB で 2,000 段は動かせない。open-items の Known limits）。
deep_goal(recover 2000 goal)
file(WRITE "${WORK}/deep_cells.pl" ":- initialization(main, main).\ng.\ncells :- ${goal}.\nmain :- cells.\n")
set(COMMAND "${MOSAC}" emit deep_cells.pl -o out_cells)
include("${SMALL_STACK}")
file(READ "${WORK}/out_cells/u0.cpp" unit)
string(FIND "${unit}" "void pcells_0_c1(Machine::Impl& m" at)
string(FIND "${unit}" "void pmain_0_c1(Machine::Impl& m" main_at)
if(NOT at EQUAL -1 OR main_at EQUAL -1)
  set(code "-")
  set(out "cells")
  fail("a clause whose frames carry over 2^20 variable cells must run as IR")
endif()

execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${compiler_env} "${MOSAC}" build deep_body.pl -o deep_body_exe
  WORKING_DIRECTORY "${WORK}" OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE code TIMEOUT 900 ENCODING UTF-8)
if(NOT code EQUAL 0)
  fail("mosac build deep_body.pl")
endif()
set(COMMAND "${WORK}/deep_body_exe${EXE_SUFFIX}")
set(EXPECTED "${WORK}/deep_body.expected")
include("${SMALL_STACK}")

?- spy(true/0).
% true/0 にはポートが無いので、スパイポイントを置きません
true.
?- spy('no such').
% 'no such' という名前の述語はありません
true.
?- spy((-)/1), nospy((-)/1).
% (-)/1 にスパイポイントを置きました
% (-)/1 のスパイポイントを外しました
true.
[debug] ?- spy(長さ/2).
% 長さ/2 にスパイポイントを置きました
true.
[debug] ?- set_prolog_flag(japanese_punctuation, true), spy('、'/0), spy('：'/1), nospy('、'/0), nospy('：'/1).
% '、'/0 にスパイポイントを置きました
% '：'/1 にスパイポイントを置きました
% '、'/0 のスパイポイントを外しました
% '：'/1 のスパイポイントを外しました
true.
[debug] ?- 
?- spy(true/0).
% true/0 has no ports, so it gets no spy point
true.
?- spy([]).
true.
?- spy(dbg_no_such).
% No predicate named dbg_no_such
true.
?- debugging.
% Debug mode: off
% Spy points: none
% Leashed ports: call exit redo fail exception
true.
?- spy(call/1).
% call/1 has no ports, so it gets no spy point
true.
?- spy(('a, b')/1).
% Spy point on 'a, b'/1
true.
[debug] ?- spy(lists:dbg_hidden/1).
% Spy point on lists:dbg_hidden/1
true.
[debug] ?- spy(dbg_hidden/1).
% Spy point on dbg_hidden/1
true.
[debug] ?- debugging.
% Debug mode: on (leap)
% Spy points: 'a, b'/1, lists:dbg_hidden/1, dbg_hidden/1
% Leashed ports: call exit redo fail exception
true.
[debug] ?- nospyall.
true.
[debug] ?- spy(pairs_keys/2), use_module(library(pairs)), debugging, nospy(pairs_keys/2).
% Spy point on pairs_keys/2
% Debug mode: on (leap)
% Spy points: pairs_keys/2
% Leashed ports: call exit redo fail exception
% Spy point removed from pairs_keys/2
true.
[debug] ?- spy((-)/1), spy((=)/2), debugging, nospy((-)/1).
% Spy point on (-)/1
% Spy point on (=)/2
% Debug mode: on (leap)
% Spy points: (-)/1, (=)/2
% Leashed ports: call exit redo fail exception
% Spy point removed from (-)/1
true.
[debug] ?- spy(lists:dbg_hidden/1), nospy(lists:dbg_hidden/1).
% Spy point on lists:dbg_hidden/1
% Spy point removed from lists:dbg_hidden/1
true.
[debug] ?- spy('no such').
% No predicate named 'no such'
true.
[debug] ?- spy(lists:dbg_hidden/1), nospy(dbg_hidden), debugging, nospy(lists:dbg_hidden/1).
% Spy point on lists:dbg_hidden/1
% Debug mode: on (leap)
% Spy points: (=)/2, lists:dbg_hidden/1
% Leashed ports: call exit redo fail exception
% Spy point removed from lists:dbg_hidden/1
true.
[debug] ?- spy(''/0), spy((+++)/1), spy('.'/2), debugging, nospy(''/0), nospy((+++)/1), nospy('.'/2).
% Spy point on ''/0
% Spy point on +++ /1
% Spy point on '.'/2
% Debug mode: on (leap)
% Spy points: (=)/2, ''/0, +++ /1, '.'/2
% Leashed ports: call exit redo fail exception
% Spy point removed from ''/0
% Spy point removed from +++ /1
% Spy point removed from '.'/2
true.
[debug] ?- op(1100, xfx, /), spy((dbg_op/1)), nospy((dbg_op/1)), op(400, yfx, /).
% Spy point on (dbg_op/1)
% Spy point removed from (dbg_op/1)
true.
[debug] ?- 